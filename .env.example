# Public site URL (canonical links / SEO)
NEXT_PUBLIC_SITE_URL=https://www.stuartthomasconstruction.ca

# Contact form email — preferred provider
# Create a key at https://resend.com (verify domain for custom From addresses)
RESEND_API_KEY=
# Optional override; defaults to site.email in src/data/site.ts
CONTACT_TO_EMAIL=
# Optional verified sender, e.g. "Stuart Thomas Construction <quotes@yourdomain.com>"
CONTACT_FROM_EMAIL=

# If RESEND_API_KEY is empty, the API falls back to FormSubmit.co (still no mailto /
# Gmail compose). The owner may need to confirm the first FormSubmit activation email.
