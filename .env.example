# Public site URL (canonical links / SEO)
NEXT_PUBLIC_SITE_URL=https://www.stuartthomasconstruction.ca

# ── Contact / snow quote form delivery (REQUIRED for production email) ────────
# Without RESEND_API_KEY, forms cannot reliably email the business inbox.
#
# Setup (one-time, ~2 minutes):
# 1. Create a free account at https://resend.com
# 2. API Keys → Create API Key → copy the key (starts with re_)
# 3. Vercel → stuart-thomas-construction → Settings → Environment Variables
# 4. Add:
#      RESEND_API_KEY = <your key>     (Production + Preview + Development)
#      CONTACT_TO_EMAIL = <Resend account email>
#         IMPORTANT: With the default from address (onboarding@resend.dev), Resend
#         only delivers to the email that owns the API key. Sending to any other
#         address returns 403 until you verify a domain.
#    After verifying your domain at https://resend.com/domains:
#      CONTACT_FROM_EMAIL = Stuart Thomas Construction <quotes@stuartthomasconstruction.ca>
#      CONTACT_TO_EMAIL = stutomfarm08@gmail.com   (any inbox you want)
#    Until the domain is verified, leave CONTACT_FROM_EMAIL empty (defaults to
#    onboarding@resend.dev) and keep CONTACT_TO_EMAIL = the Resend account email.
# 5. Redeploy (Deployments → … → Redeploy) so the new env is picked up.
#
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Do NOT rely on FormSubmit.co for production — it requires a one-time
# “Activate Form” click in the business inbox and often fails from Vercel.
