# Public site URL (canonical links / SEO)
NEXT_PUBLIC_SITE_URL=https://www.stuartthomasconstruction.ca

# Contact form email (Resend) — required in Vercel for quote/contact submissions
# Create a key at https://resend.com — verify your domain for production From addresses
RESEND_API_KEY=
# Optional override; defaults to site.email in src/data/site.ts
CONTACT_TO_EMAIL=
# Optional verified sender, e.g. "Stuart Thomas Construction <quotes@yourdomain.com>"
# Defaults to Resend onboarding address until a domain is verified
CONTACT_FROM_EMAIL=
